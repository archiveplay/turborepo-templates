{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*", "**/tsconfig.json", "**/turbo.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "env": ["PORT", "DATABASE_URL"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "db:generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["node_modules/.prisma/**"]
    },
    "db:migrate:dev": {
      "cache": false,
      "persistent": false
    },
    "generate:openapi": {
      "cache": false
    },
    "generate:sdk": {
      "inputs": ["openapi.json"],
      "outputs": ["clients/core.ts", "clients/vue.ts", "clients/react.ts"]
    }
  }
}
