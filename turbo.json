{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*", "**/tsconfig.json", "**/turbo.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate:sdk"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "env": ["PORT", "DATABASE_URL"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "generate:openapi": {
      "cache": false,
      "outputs": ["openapi.json"]
    },
    "generate:sdk": {
      "dependsOn": ["generate:openapi"],
      "inputs": ["openapi.json"],
      "outputs": ["client.ts"],
      "cache": false
    }
  }
}
